<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.cleantv.launcher" android:versionCode="1" android:versionName="1.0">
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="30"/>
  <uses-feature android:name="android.software.leanback" android:required="false"/>
  <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
  <queries><intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent><intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent></queries>
  <application android:label="CleanTV" android:icon="@drawable/icon" android:banner="@drawable/banner" android:theme="@android:style/Theme.Material.NoActionBar" android:allowBackup="false" android:supportsRtl="true">
    <activity android:name=".HomeActivity" android:exported="true" android:screenOrientation="landscape" android:launchMode="singleTask">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.HOME"/><category android:name="android.intent.category.LAUNCHER"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
    </activity>
    <activity android:name=".PickActivity" android:exported="false" android:screenOrientation="landscape"/>

  </application>
</manifest>
